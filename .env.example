# 1) MongoDB Atlas connection string, WITH the database name after ".net/".
#    Note: the password contains "@", which MUST be URL-encoded as "%40" —
#    a raw "@" would be parsed as the start of the host and the connection
#    would fail. Real password: Afzal@0786 → Afzal%400786
MONGODB_URI=mongodb+srv://theafzalhussain786_db_user6:Afzal%400786@cluster0.giubmn2.mongodb.net/portfolio?retryWrites=true&w=majority&appName=Cluster0

# 2) SMTP. For Gmail you MUST use a 16-character App Password
#    (myaccount.google.com/apppasswords) — the normal account password
#    will be rejected. Spaces in the password are fine, they get stripped.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=theafzalhussain786@gmail.com
EMAIL_PASS=ptfd ugiv cldy vdlj

# 3) Where the "new message" notification goes. Leave empty to fall back to
#    the address hard-coded in lib/mail.ts.
ADMIN_EMAIL=theafzalhussain786@gmail.com

# 4) Optional. Overrides the From header. Must still be the same mailbox as
#    EMAIL_USER (or a verified alias of it), otherwise Gmail rejects it.
# EMAIL_FROM="Afzal Hussain <you@gmail.com>"

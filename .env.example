# Copy this file to `.env.local` and fill in real values.
# Never commit `.env` or `.env*.local` — they are gitignored.

# MongoDB Atlas connection string, including the database name, e.g.
# mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# SMTP (for Gmail use a 16-character App Password — see SETUP_CONTACT_FORM.md)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=you@example.com
EMAIL_PASS=your-app-password

# Recipient of the admin notification email.
# Falls back to the address hard-coded in lib/mail.ts when left empty.
ADMIN_EMAIL=you@example.com
